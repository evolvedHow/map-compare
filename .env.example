# map-compare — AI Narrative Configuration
# Copy to .env and fill in your key:  cp .env.example .env
#
# ⚠ NEVER commit .env. This repository is PUBLIC — a key pushed here is
#   scraped within minutes. .env and .env.* are gitignored; keep it that way.
#   .env is for LOCAL DEVELOPMENT ONLY.
#
# Where the key actually belongs, by environment:
#
#   local dev (npm run dev)   → this file. Vite's dev middleware reads it and
#                               calls the provider from Node, so the key never
#                               reaches the browser.
#   deployed backend          → Railway dashboard → service → Variables.
#                               Set AI_PROVIDER and AI_API_KEY there.
#   deployed frontend (Pages) → nothing. A static site cannot hold a secret;
#                               anything baked into the build is public. It
#                               only needs VITE_ANALYZE_API_URL (a plain URL,
#                               not a secret) to know which backend to call.
#
# ── AI Provider ───────────────────────────────────────────────────────────────
# Supported providers (dev middleware and FastAPI backend accept the same set):
#   groq       — Llama 3.3 70B (free tier, fast)  https://console.groq.com
#   anthropic  — Claude Sonnet (best analysis)    https://console.anthropic.com
#   openai     — GPT-4o-mini                       https://platform.openai.com
#   openrouter — Gemini Flash default             https://openrouter.ai
#   google     — Gemini Flash Lite                https://aistudio.google.com

AI_PROVIDER=groq
AI_API_KEY=your_api_key_here

# Optional: override the default model for the chosen provider.
# Defaults use rolling aliases where the provider offers them, so pinned
# versions can't silently retire out from under you.
# AI_MODEL=llama-3.3-70b-versatile

# ── Production frontend (GitHub Pages build) ──────────────────────────────────
# VITE_ANALYZE_API_URL tells the static build where to POST /api/analyze.
# NOT a secret — it is a public URL, visible in the shipped JS either way.
# For the Pages deploy, set it as a GitHub Actions *variable*
# (Settings → Secrets and variables → Actions → Variables), not a secret;
# .github/workflows/deploy.yml already passes vars.VITE_ANALYZE_API_URL through.
# Leave blank in dev — the Vite dev-server middleware handles the call locally.
# VITE_ANALYZE_API_URL=https://map-compare-api.up.railway.app

# ── Backend CORS ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed by the FastAPI backend (default: * = all)
# ALLOWED_ORIGINS=https://fairdistricts.ga,https://vgana.github.io
