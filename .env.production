# map-compare — production build config (COMMITTED ON PURPOSE)
#
# Vite loads this automatically during `npm run build`. It exists so the
# GitHub Pages deploy is fully pre-configured: nobody has to set anything in
# the GitHub UI, and end users configure nothing at all.
#
# ⚠ ONLY non-secret, VITE_-prefixed values belong here. Everything in this
#   file is compiled into the public JavaScript bundle and is readable by
#   every visitor. NEVER put AI_API_KEY (or any key) in this file.
#   The AI key lives on the Railway backend — see .env.example.

# The Railway backend that serves POST /api/analyze.
# A public URL, not a secret — the browser has to know it to call it.
# Must NOT have a trailing slash: the client appends "/api/analyze".
VITE_ANALYZE_API_URL=
